# Claude API (讯飞 AI 云平台) - 必填
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=https://one.iflytek.com/api/llm/console/chat
ANTHROPIC_MODEL=claude-sonnet-4-6

# 飞书配置（使用飞书机器人时必填）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=  # 可选，如果开启了消息加密

# 飞书文档抓取（使用飞书文档抓取功能时必填）
FEISHU_DOC_APP_ID=cli_xxx
FEISHU_DOC_APP_SECRET=your_doc_app_secret

# 服务配置
HOST=0.0.0.0
PORT=8123

# 飞书 API 域名（讯飞内部使用）
FEISHU_DOMAIN=https://open.xfchat.iflytek.com

# 自调用 URL（飞书回调内部调用对话接口）
FEISHU_CHAT_URL=http://127.0.0.1:8123/api/chat
